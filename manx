def get_system_man_index():
    cache_file = os.path.join(get_cache_dir(), "man_index.json")

    # If cache exists and is newer than 24 hours, use it
    if os.path.isfile(cache_file):
        try:
            mtime = os.path.getmtime(cache_file)
            if time.time() - mtime < 86400:
                with open(cache_file, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception:
            pass

    mans = {}
    try:
        res = subprocess.run(["man", "-k", "."], capture_output=True, text=True, errors="replace")
        for line in res.stdout.splitlines():
            if " - " in line:
                parts = line.split(" - ", 1)
                name_part = parts[0].strip()
                desc = parts[1].strip()
                # e.g., 'find (1)' -> 'find'
                cmd = name_part.split()[0].rstrip(",;:")
                if cmd and cmd not in mans:
                    mans[cmd] = desc
    except Exception:
        pass

    try:
        with open(cache_file, "w", encoding="utf-8") as f:
            json.dump(mans, f)
    except Exception:
        pass

    return mans

def get_all_commands():
    """
    Returns sorted list of tuples: (cmd, desc, source_flag)
    """
    tldr_idx = get_tldr_index()
    man_idx = get_system_man_index()
    builtins = get_bash_builtins()

    all_names = set(tldr_idx.keys()) | set(man_idx.keys()) | set(builtins.keys())
    result = []

    for cmd in sorted(all_names):
        # Determine best description
        desc = ""
        source = "man"
        if cmd in tldr_idx:
            source = "tldr"
            # Fast peek description from tldr or fallback to man
            desc = man_idx.get(cmd, "")
        elif cmd in builtins:
            source = "builtin"
            desc = builtins[cmd]
        else:
            desc = man_idx.get(cmd, "")

        result.append((cmd, desc, source))

    return result

# --- MAN PAGE & OPTIONS ENGINE ---
def get_raw_man(cmd_name):
    cmd_name = cmd_name.strip()
    cache_file = os.path.join(get_cache_dir(), "man", f"{cmd_name}.txt")
    if os.path.isfile(cache_file):
        try:
            with open(cache_file, "r", encoding="utf-8", errors="replace") as f:
                return f.read()
        except Exception:
            pass

    try:
        res = subprocess.run(["man", cmd_name], capture_output=True, text=True, errors="replace")
        if res.returncode == 0 and res.stdout:
            raw = subprocess.run(["col", "-bx"], input=res.stdout, capture_output=True, text=True).stdout
            try:
                with open(cache_file, "w", encoding="utf-8") as f:
                    f.write(raw)
            except Exception:
                pass
            return raw
    except Exception:
        pass
    return ""

def get_man_options(cmd_name):
    cmd_name = cmd_name.strip()
    cache_file = os.path.join(get_cache_dir(), "options", f"{cmd_name}.json")
    if os.path.isfile(cache_file):
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass

    raw = get_raw_man(cmd_name)
    if not raw:
        return []

    lines = raw.splitlines()
    options = []
    current_opt = None
    current_desc = []

    for line in lines:
        m = re.match(r"^ {2,8}(-[a-zA-Z0-9_\-\+]+(?:[^\n]*))$", line)
        if m:
            if current_opt and current_desc:
                tag = current_opt.split()[0].rstrip(",;:")
                options.append({"tag": tag, "header": current_opt, "desc": " ".join(current_desc).strip()})
            current_opt = m.group(1).strip()
            current_desc = []
        elif current_opt:
            if re.match(r"^ {6,}\S", line):
                current_desc.append(line.strip())
            elif re.match(r"^[A-Z]", line):
                if current_opt and current_desc:
                    tag = current_opt.split()[0].rstrip(",;:")
                    options.append({"tag": tag, "header": current_opt, "desc": " ".join(current_desc).strip()})
                current_opt = None
                current_desc = []

    if current_opt and current_desc:
        tag = current_opt.split()[0].rstrip(",;:")
        options.append({"tag": tag, "header": current_opt, "desc": " ".join(current_desc).strip()})

    try:
        with open(cache_file, "w", encoding="utf-8") as f:
            json.dump(options, f)
    except Exception:
        pass

    return options

def preview_man(cmd_name):
    cmd_name = cmd_name.strip()
    raw = get_raw_man(cmd_name)
    if not raw:
        print(f"\n{C_HEAD}:: {C_BOLD}{cmd_name}{NC} — {C_ERR}No system manual available.{NC}\n")
        return

    print(f"\n{C_HEAD}:: {C_BOLD}{cmd_name.upper()}(1) — Full System Manual{NC} \033[38;5;60m(Shift-Up/Down to Scroll){NC}\n")
    for line in raw.splitlines():
        if re.match(r"^[A-Z][A-Z0-9_\- ]+$", line.strip()) and not line.startswith(" "):
            print(f"\n{C_HEAD}:: {C_BOLD}{line.strip()}{NC}")
        elif re.match(r"^\s{2,8}(-[a-zA-Z0-9_\-\+]+.*)$", line):
            m = re.match(r"^\s{2,8}(-[a-zA-Z0-9_\-\+]+.*)$", line)
            print(f"  {C_PROMPT}➜ {C_CMD}{m.group(1).strip()}{NC}")
        else:
            print(f"  {C_TEXT}{line}{NC}")

def preview_item(item_string, cmd_name):
    item_string = item_string.strip()
    cmd_name = cmd_name.strip()

    if item_string.startswith("[-"):
        opts = get_man_options(cmd_name)
        opt_part = item_string.split("\t")[0].strip()
        m_tag = re.match(r"^\[(-[^\]]+)\]\s*(.*)$", opt_part)
        target_tag = m_tag.group(1) if m_tag else ""
        target_header = m_tag.group(2).strip() if m_tag else opt_part

        matched = None
        for o in opts:
            if o["header"] == target_header or o["tag"] == target_tag:
                matched = o
                break

        if matched:
            print(f"\n{C_HEAD}:: {C_BOLD}{cmd_name}(1) — Flag / Option Reference{NC}\n")
            print(f"  {C_PROMPT}➜ {C_CMD}{matched['header']}{NC}\n")
            print(f"{C_HEAD}:: {C_BOLD}Description & Usage:{NC}\n")
            desc_sentences = matched["desc"].split(". ")
            cur_p = []
            for sent in desc_sentences:
                cur_p.append(sent)
                if len(". ".join(cur_p)) > 120:
                    print(f"  {C_TEXT}{'. '.join(cur_p)}.{NC}\n")
                    cur_p = []
            if cur_p:
                print(f"  {C_TEXT}{'. '.join(cur_p)}{NC}\n")

            print(f"{C_DIM}─────────────────────────────────────────────────────────────────────────────{NC}")
            print(f"  {C_OPT}Switch View:{NC} [Alt-M/Ctrl-P] Full Man Page  {C_MUTED}•{NC}  [Ctrl-T] TLDR  {C_MUTED}•{NC}  [Ctrl-W] cheat.sh\n")
            return

    if item_string.startswith("[m]"):
        preview_man(cmd_name)
        return
    elif item_string.startswith("[w]"):
        preview_web(cmd_name)
        return

    render_unified_card(cmd_name, is_preview=True)

def print_matching_options(cmd_name, query):
    query_lower = query.lower().strip()
    opts = get_man_options(cmd_name)
    matches = [
        o for o in opts
        if query_lower in o["tag"].lower() or query_lower in o["header"].lower() or query_lower in o["desc"].lower()
    ]
    if not matches:
        print(f"\n{C_ERR}✖{NC} No options in {cmd_name}(1) matching '{query}'.\n")
        return

    print(f"\n{C_HEAD}:: {C_BOLD}{cmd_name}(1) — Man Options matching '{query}'{NC} \033[38;5;60m({len(matches)} found)\033[0m\n")
    for o in matches[:15]:
        print(f"  {C_PROMPT}➜ {C_CMD}{o['header']}{NC}")
        print(f"    {C_TEXT}{o['desc'][:220]}...{NC}\n")

# --- CHEAT.SH CLIENT & CACHE ---
def fetch_cheat_sh(cmd):
    cache_path = os.path.join(get_cache_dir(), "cheat", f"{cmd}.txt")
    if os.path.isfile(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8", errors="replace") as f:
                return f.read()
        except Exception:
            pass

    url = f"https://cheat.sh/{urllib.parse.quote(cmd)}?T"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "curl/7.88.1"}
    )
    try:
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            content = resp.read().decode("utf-8", errors="replace")
            # Strip cheat.sh header comments if any
            clean_lines = []
            for line in content.splitlines():
                if line.startswith("#[cheat.sheets"):
                    continue
                clean_lines.append(line)
            content = "\n".join(clean_lines).strip()
            if content and "Unknown topic" not in content:
                try:
                    with open(cache_path, "w", encoding="utf-8") as f:
                        f.write(content)
                except Exception:
                    pass
                return content
    except Exception:
        pass

    return None

# --- EXPLAIN ENGINE (Mankier API & Offline Regex Parser) ---
def fetch_mankier_explain(cmd_string):
    cmd_clean = cmd_string.strip()
    h = hashlib.sha256(cmd_clean.encode("utf-8")).hexdigest()[:16]
    cache_path = os.path.join(get_cache_dir(), "explain", f"{h}.txt")

    if os.path.isfile(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8", errors="replace") as f:
                return f.read()
        except Exception:
            pass

    cols = shutil.get_terminal_size().columns
    url = f"https://www.mankier.com/api/v2/explain/?cols={cols}&q={urllib.parse.quote(cmd_clean)}"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "manx-cli/1.0"}
    )
    try:
        with urllib.request.urlopen(req, timeout=3.5) as resp:
            data = resp.read().decode("utf-8", errors="replace").strip()
            if data:
                try:
                    with open(cache_path, "w", encoding="utf-8") as f:
                        f.write(data)
                except Exception:
                    pass
                return data
    except Exception:
        pass

    # Offline fallback
    return offline_explain(cmd_clean)

def offline_explain(cmd_string):
    tokens = cmd_string.strip().split()
    if not tokens:
        return "Empty command."

    base_cmd = os.path.basename(tokens[0])
    flags = [t for t in tokens[1:] if t.startswith("-")]

    lines = [f"{base_cmd}(1) — Local Offline Flag Breakdown\n"]
    if not flags:
        lines.append("  No specific command-line flags detected.")
        return "\n".join(lines)

    # Read man page
    try:
        res = subprocess.run(["man", base_cmd], capture_output=True, text=True, errors="replace")
        man_text = subprocess.run(["col", "-bx"], input=res.stdout, capture_output=True, text=True).stdout
    except Exception:
        man_text = ""

    for flag in flags:
        lines.append(f"  {flag}")
        if man_text:
            pattern = rf"(?:^|\n)\s+({re.escape(flag)}(?:[=,\s][^\n]+)?)\n((?:\s{{4,}}[^\n]+\n)+)"
            m = re.search(pattern, man_text)
            if m:
                desc = re.sub(r"\s+", " ", m.group(2).strip())
                lines.append(f"    {desc[:240]}...\n")
            else:
                lines.append("    Flag found in command (refer to full man page for details).\n")
        else:
            lines.append("    Standard command argument.\n")

    return "\n".join(lines)

# --- UNIFIED CARD RENDERER ---
def highlight_command(cmd_raw):
    """
    Highlights {{placeholder}} inside command strings
    """
    parts = []
    last_idx = 0
    for m in re.finditer(r"\{\{([^}]+)\}\}", cmd_raw):
        parts.append(f"{C_CMD}{cmd_raw[last_idx:m.start()]}{NC}")
        parts.append(f"{C_PARAM}{m.group(1)}{NC}")
        last_idx = m.end()
    parts.append(f"{C_CMD}{cmd_raw[last_idx:]}{NC}")
    return "".join(parts)

def render_unified_card(cmd_name, is_preview=True):
    cmd_name = cmd_name.strip()
    tldr_idx = get_tldr_index()
    man_idx = get_system_man_index()
    builtins = get_bash_builtins()

    data = None
    if cmd_name in tldr_idx:
        data = parse_tldr_file(tldr_idx[cmd_name])

    # Header section
    desc = ""
    if data and data.get("description"):
        desc = data["description"]
    elif cmd_name in man_idx:
        desc = man_idx[cmd_name]
    elif cmd_name in builtins:
        desc = builtins[cmd_name]
    else:
        desc = "System Command"

    print(f"\n{C_HEAD}:: {C_BOLD}{cmd_name}{NC} \033[38;5;60m— {desc}{NC}")

    if data and data.get("docs"):
        print(f"  {C_ACTION}➜{NC} {C_OPT}Docs:{NC} \033[4;38;5;111m{data['docs']}{NC}")

    # Top practical cheatsheets
    if data and data.get("examples"):
        print(f"\n{C_HEAD}:: {C_BOLD}Top Cheatsheet & Practical Examples{NC}")
        for idx, eg in enumerate(data["examples"], start=1):
            num = f"{C_PROMPT}[{idx}]{NC}"
            desc_text = f"{C_TEXT}{eg['desc']}{NC}"
            cmd_styled = highlight_command(eg["raw_cmd"])
            print(f"  {num} {desc_text}")
            print(f"      {C_ACTION}➜{NC} {cmd_styled}\n")
    else:
        # Check if it's a builtin
        if cmd_name in builtins:
            print(f"\n{C_HEAD}:: {C_BOLD}Shell Builtin Syntax{NC}")
            try:
                res = subprocess.run(["bash", "-c", f"help {cmd_name}"], capture_output=True, text=True)
                lines = [l for l in res.stdout.splitlines() if l.strip()][:15]
                for l in lines:
                    print(f"  {C_TEXT}{l}{NC}")
            except Exception:
                print(f"  {C_TEXT}{builtins[cmd_name]}{NC}")
        else:
            # Fallback: check cheat.sh or man synopsis
            print(f"\n{C_HEAD}:: {C_BOLD}System Manual Overview{NC}")
            try:
                res = subprocess.run(["man", cmd_name], capture_output=True, text=True, errors="replace")
                raw = subprocess.run(["col", "-bx"], input=res.stdout, capture_output=True, text=True).stdout
                m = re.search(r"SYNOPSIS\n(.*?)\n\n[A-Z]", raw, re.DOTALL)
                if m:
                    print(f"  {C_ACTION}➜{NC} {C_BOLD}SYNOPSIS:{NC}")
                    for s_line in m.group(1).strip().splitlines()[:6]:
                        print(f"    {C_CMD}{s_line.strip()}{NC}")
            except Exception:
                pass
            print(f"\n  {C_OPT}Press [Ctrl-O] or run `manx -m {cmd_name}` for the complete manual.{NC}")

    # Footer navigation hints
    print(f"{C_DIM}─────────────────────────────────────────────────────────────────────────────{NC}")
    if is_preview:
        print(f"  {C_OPT}Actions:{NC} [Enter] Pick & Copy Snippet  {C_MUTED}•{NC}  [Ctrl-O] Full Manual  {C_MUTED}•{NC}  [Ctrl-W] cheat.sh\n")
    else:
        print(f"  {C_OPT}Hint:{NC} Run `manx {cmd_name}` for interactive picker or `manx -m {cmd_name}` for full manual.\n")

# --- INTERACTIVE SNIPPET & OPTIONS PICKER ---
def launch_snippet_picker(cmd_name, initial_query="", print_on_cancel=True):
    cmd_name = cmd_name.strip()
    tldr_idx = get_tldr_index()
    man_idx = get_system_man_index()
    builtins = get_bash_builtins()

    data = None
    if cmd_name in tldr_idx:
        data = parse_tldr_file(tldr_idx[cmd_name])

    examples = data.get("examples", []) if data else []
    desc = ""
    if data and data.get("description"):
        desc = data["description"]
    elif cmd_name in man_idx:
        desc = man_idx[cmd_name]
    elif cmd_name in builtins:
        desc = builtins[cmd_name]

    # Fetch all options/flags from the man page
    man_options = get_man_options(cmd_name)

    if not examples and not man_options:
        if cmd_name in builtins:
            render_unified_card(cmd_name, is_preview=False)
            return
        print_action(f"No predefined snippets for '{cmd_name}'. Opening full manual...")
        open_full_man(cmd_name)
        return

    # Prepare FZF lines
    fzf_lines = []

    # 1. Curated TLDR examples
    for idx, eg in enumerate(examples, start=1):
        clean = eg["clean_cmd"]
        eg_desc = eg["desc"]
        fzf_lines.append(f"[{idx}] {clean} \t:: [snippet] {eg_desc}")

    # 2. Options and flags extracted from system man page
    for opt in man_options:
        tag = opt["tag"]
        header = opt["header"]
        short_desc = opt["desc"][:90]
        if len(opt["desc"]) > 90:
            short_desc += "..."
        fzf_lines.append(f"[{tag}] {header} \t:: [man] {short_desc}")

    # 3. Actions to toggle views
    fzf_lines.append(f"[m] 📖 View Full Man Page in Preview (Alt-M / Ctrl-P) \t:: [action] Complete system reference")
    fzf_lines.append(f"[w] 🌐 Query cheat.sh Community Sheet (Ctrl-W) \t:: [action] Community snippets")

    fzf_input = "\n".join(fzf_lines)
    script_path = os.path.abspath(__file__)

    short_desc = (desc[:60] + "...") if len(desc) > 60 else desc
    header_text = f":: {cmd_name} — {short_desc}\n[Enter] Copy & Output  •  [Alt-M/Ctrl-P] Man Page  •  [Ctrl-T] TLDR  •  [Ctrl-W] cheat.sh  •  [Esc] Cancel"

    cmd = [
        "fzf",
        "--ansi",
        f"--prompt=:: {cmd_name} ➜ ",
        f"--header={header_text}",
        "--delimiter=\t:: ",
        "--with-nth=1,2",
        f"--preview={script_path} --preview-item {{1}} {cmd_name}",
        "--preview-window=right,58%,wrap,<100(bottom,50%,wrap)",
        f"--bind=ctrl-o:execute({script_path} -m {cmd_name})",
        f"--bind=ctrl-w:change-preview({script_path} --preview-web {cmd_name})",
        f"--bind=ctrl-t:change-preview({script_path} --preview {cmd_name})",
        f"--bind=ctrl-p:change-preview({script_path} --preview-man {cmd_name})",
        f"--bind=alt-m:change-preview({script_path} --preview-man {cmd_name})",
        "--color=bg+:#1f2335,bg:#1a1b26,spinner:#7aa2f7,hl:#7dcfff,fg:#c0caf5,header:#7aa2f7,info:#e0af68,pointer:#bb9af7,marker:#9ece6a,fg+:#c0caf5,prompt:#bb9af7,hl+:#7dcfff"
    ]

    if initial_query:
        cmd.append(f"--query={initial_query}")

    try:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = p.communicate(input=fzf_input)
        if p.returncode != 0 or not out.strip():
            if print_on_cancel:
                render_unified_card(cmd_name, is_preview=False)
            return

        selected = out.strip()
        if "[m] 📖 View Full Man Page" in selected:
            open_full_man(cmd_name)
            return
        elif "[w] 🌐 Query cheat.sh" in selected:
            preview_web(cmd_name)
            return

        # Extract snippet or option command
        m = re.match(r"^\[(?:\d+|-[^\]]+)\]\s*(.*?)(?:\s*\t::.*)?$", selected)
        chosen_cmd = m.group(1).strip() if m else selected

        # Copy to clipboard
        copy_to_clipboard(chosen_cmd)

        print_succ("Copied to clipboard:")
        print(f"\n  {C_CMD}{chosen_cmd}{NC}\n")

    except FileNotFoundError:
        print_err("fzf is not installed or not found in PATH.")
        render_unified_card(cmd_name, is_preview=False)

# --- FULL MAN PAGER ---
def open_full_man(cmd_name):
    cmd_name = cmd_name.strip()
    if shutil.which("bat"):
        os.system(f"man {cmd_name} 2>/dev/null | col -bx | bat -l man -p --paging=always || man {cmd_name}")
    else:
        os.system(f"man {cmd_name}")

# --- REVERSE SEARCH ---
def search_cheatsheets(query):
    query_raw = query.strip()
    query_lower = query_raw.lower()
    root = find_tldr_root()
    if not root:
        print_err("TLDR pages directory not found.")
        return

    print_head(f"Reverse Search: '{query_raw}'")
    scored_matches = []

    pattern = re.compile(rf"\b{re.escape(query_lower)}\b", re.IGNORECASE)

    platforms = ["common", "linux", "osx"]
    seen_cmds = set()
    for plat in platforms:
        pdir = os.path.join(root, plat)
        if os.path.isdir(pdir):
            for entry in os.scandir(pdir):
                if entry.name.endswith(".md"):
                    cmd_name = entry.name[:-3]
                    if cmd_name in seen_cmds:
                        continue
                    seen_cmds.add(cmd_name)
                    try:
                        with open(entry.path, "r", encoding="utf-8", errors="ignore") as f:
                            content = f.read()
                        content_lower = content.lower()
                        if query_lower in content_lower:
                            score = 0
                            if cmd_name.lower() == query_lower:
                                score += 200
                            elif cmd_name.lower().startswith(query_lower):
                                score += 80
                            elif pattern.search(cmd_name.lower()):
                                score += 50

                            data = parse_tldr_file(entry.path)
                            if data:
                                desc = data.get("description", "")
                                if pattern.search(desc.lower()):
                                    score += 40
                                elif query_lower in desc.lower():
                                    score += 15

                                matching_egs = []
                                for eg in data.get("examples", []):
                                    eg_desc = eg.get("desc", "")
                                    eg_cmd = eg.get("raw_cmd", "")
                                    eg_score = 0
                                    if pattern.search(eg_desc.lower()):
                                        eg_score += 20
                                    elif query_lower in eg_desc.lower():
                                        eg_score += 10

                                    if pattern.search(eg_cmd.lower()):
                                        eg_score += 15
                                    elif query_lower in eg_cmd.lower():
                                        eg_score += 5

                                    if eg_score > 0:
                                        matching_egs.append((eg, eg_score))
                                        score += eg_score

                                if score > 0:
                                    matching_egs.sort(key=lambda x: x[1], reverse=True)
                                    top_egs = [x[0] for x in matching_egs]
                                    scored_matches.append((score, cmd_name, desc, top_egs))
                    except Exception:
                        pass

    if not scored_matches:
        print(f"  {C_ERR}✖{NC} No cheatsheet matches found for '{query_raw}'.\n")
        return

    scored_matches.sort(key=lambda x: x[0], reverse=True)

    print(f"  {C_ACTION}➜{NC} Found {C_BOLD}{len(scored_matches)}{NC} matching commands (showing top 10):\n")
    for score, cmd_name, desc, egs in scored_matches[:10]:
        print(f"  {C_HEAD}:: {C_BOLD}{cmd_name}{NC} {C_OPT}— {desc}{NC}")
        for eg in egs[:2]:
            clean_cmd = highlight_command(eg["raw_cmd"])
            print(f"     {C_TEXT}• {eg['desc']}{NC}")
            print(f"       ➜ {clean_cmd}")
        print()

# --- MAIN INTERACTIVE FZF BROWSER ---
def launch_main_fzf():
    all_cmds = get_all_commands()

    # Format lines for FZF: "command\t:: description"
    fzf_lines = []
    for cmd, desc, source in all_cmds:
        tag = f"[{source}]"
        fzf_lines.append(f"{cmd}\t:: {tag} {desc}")

    fzf_input = "\n".join(fzf_lines)
    script_path = os.path.abspath(__file__)

    fzf_cmd = [
        "fzf",
        "--ansi",
        "--prompt=:: manx ➜ ",
        "--header=[Enter] Pick Snippet & Options  •  [Alt-M/Ctrl-P] Man Page  •  [Ctrl-T] TLDR  •  [Ctrl-W] cheat.sh  •  [Esc] Quit",
        "--delimiter=\t:: ",
        "--with-nth=1,2",
        f"--preview={script_path} --preview {{1}}",
        "--preview-window=right,60%,wrap,<100(bottom,50%,wrap)",
        f"--bind=ctrl-o:execute({script_path} -m {{1}})",
        f"--bind=ctrl-y:execute-silent({script_path} --copy-top {{1}})+abort",
        f"--bind=ctrl-w:change-preview({script_path} --preview-web {{1}})",
        f"--bind=ctrl-t:change-preview({script_path} --preview {{1}})",
        f"--bind=ctrl-p:change-preview({script_path} --preview-man {{1}})",
        f"--bind=alt-m:change-preview({script_path} --preview-man {{1}})",
        "--color=bg+:#1f2335,bg:#1a1b26,spinner:#7aa2f7,hl:#7dcfff,fg:#c0caf5,header:#7aa2f7,info:#e0af68,pointer:#bb9af7,marker:#9ece6a,fg+:#c0caf5,prompt:#bb9af7,hl+:#7dcfff"
    ]

    try:
        p = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = p.communicate(input=fzf_input)
        if p.returncode != 0 or not out.strip():
            return

        # Extract selected command name
        selected_line = out.strip()
        cmd_chosen = selected_line.split("\t")[0].strip()

        if cmd_chosen:
            launch_snippet_picker(cmd_chosen)

    except FileNotFoundError:
        print_err("fzf is not installed or not in PATH.")
        sys.exit(1)

