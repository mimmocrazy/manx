def main():
    if len(sys.argv) == 1:
        launch_main_fzf()
        return

    arg1 = sys.argv[1]

    # --- FAST PATH: PREVIEWS (Zero startup overhead for FZF 60fps responsiveness) ---
    if arg1 == "--preview":
        if len(sys.argv) > 2:
            render_unified_card(sys.argv[2], is_preview=True)
        return
    elif arg1 == "--preview-man":
        if len(sys.argv) > 2:
            preview_man(sys.argv[2])
        return
    elif arg1 == "--preview-item":
        if len(sys.argv) > 3:
            preview_item(sys.argv[2], sys.argv[3])
        elif len(sys.argv) > 2:
            render_unified_card(sys.argv[2], is_preview=True)
        return
    elif arg1 == "--preview-web":
        if len(sys.argv) > 2:
            preview_web(sys.argv[2])
        return
    elif arg1 == "--copy-top":
        if len(sys.argv) > 2:
            copy_top_snippet(sys.argv[2])
        return

    # --- CLI COMMAND ROUTING ---
    if arg1 in ("-p", "--print"):
        if len(sys.argv) > 2:
            target_cmd = sys.argv[2]
            query = " ".join(sys.argv[3:]).strip() if len(sys.argv) > 3 else ""
            if query:
                print_matching_options(target_cmd, query)
            else:
                render_unified_card(target_cmd, is_preview=False)
        else:
            print_err("Command required: `manx --print <command> [query]`")
        return
    elif arg1 in ("-s", "--snippet"):
        if len(sys.argv) > 2:
            query = " ".join(sys.argv[3:]).strip() if len(sys.argv) > 3 else ""
            launch_snippet_picker(sys.argv[2], initial_query=query)
        else:
            print_err("Command required: `manx --snippet <command>`")
        return
    elif arg1 in ("-m", "--man"):
        if len(sys.argv) > 2:
            open_full_man(sys.argv[2])
        else:
            print_err("Command required: `manx --man <command>`")
        return
    elif arg1 in ("-w", "--web"):
        if len(sys.argv) > 2:
            preview_web(sys.argv[2])
        else:
            print_err("Command required: `manx --web <command>`")
        return
    elif arg1 == "explain":
        if len(sys.argv) > 2:
            run_explain(" ".join(sys.argv[2:]))
        else:
            print_err("Command string required: `manx explain \"find . -name '*.txt'\"`")
        return
    elif arg1 == "search":
        if len(sys.argv) > 2:
            search_cheatsheets(" ".join(sys.argv[2:]))
        else:
            print_err("Search query required: `manx search \"tar extract\"`")
        return
    elif arg1 == "--update":
        update_cache()
        return
    elif arg1 in ("-h", "--help"):
        print_help()
        return
    elif arg1 in ("-v", "--version"):
        print(f"manx v{VERSION}")
        return
    elif arg1.startswith("-"):
        print_err(f"Unknown flag: {arg1}")
        print_help()
        sys.exit(1)
    else:
        # Standard query: manx <command> [query...]
        target_cmd = arg1
        query = " ".join(sys.argv[2:]).strip() if len(sys.argv) > 2 else ""
        if sys.stdout.isatty():
            launch_snippet_picker(target_cmd, initial_query=query, print_on_cancel=True)
        else:
            if query:
                print_matching_options(target_cmd, query)
            else:
                render_unified_card(target_cmd, is_preview=False)

if __name__ == "__main__":
    main()
