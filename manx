# --- CLIPBOARD ENGINE (Wayland, X11, and OSC 52 fallback) ---
def copy_to_clipboard(text):
    text_clean = text.strip()
    copied = False

    # 1. Wayland wl-copy
    if shutil.which("wl-copy"):
        try:
            p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
            p.communicate(input=text_clean.encode("utf-8"), timeout=1.5)
            if p.returncode == 0:
                copied = True
        except Exception:
            pass

    # 2. X11 xclip
    if not copied and shutil.which("xclip"):
        try:
            p = subprocess.Popen(["xclip", "-selection", "clipboard"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
            p.communicate(input=text_clean.encode("utf-8"), timeout=1.5)
            if p.returncode == 0:
                copied = True
        except Exception:
            pass

    # 3. OSC 52 escape sequence (works seamlessly in SSH / tmux / modern terminals)
    try:
        b64 = base64.b64encode(text_clean.encode("utf-8")).decode("ascii")
        osc52 = f"\033]52;c;{b64}\a"
        if sys.stdout.isatty():
            sys.stdout.write(osc52)
            sys.stdout.flush()
        elif os.path.exists("/dev/tty"):
            with open("/dev/tty", "w") as tty:
                tty.write(osc52)
                tty.flush()
        copied = True
    except Exception:
        pass

    return copied

# --- PATHS & CACHING ---
def get_cache_dir():
    cache_dir = os.path.expanduser("~/.cache/manx")
    os.makedirs(cache_dir, exist_ok=True)
    os.makedirs(os.path.join(cache_dir, "cheat"), exist_ok=True)
    os.makedirs(os.path.join(cache_dir, "explain"), exist_ok=True)
    os.makedirs(os.path.join(cache_dir, "man"), exist_ok=True)
    os.makedirs(os.path.join(cache_dir, "options"), exist_ok=True)
    return cache_dir

def find_tldr_root():
    candidates = [
        os.path.expanduser("~/.cache/tldr/pages"),
        os.path.expanduser("~/.local/share/tldr/pages"),
        "/usr/share/tldr/pages",
    ]
    for c in candidates:
        if os.path.isdir(c):
            return c
    return None

# --- TLDR PARSER ---
_TLDR_INDEX = None

def get_tldr_index():
    global _TLDR_INDEX
    if _TLDR_INDEX is not None:
        return _TLDR_INDEX

    cache_file = os.path.join(get_cache_dir(), "tldr_index.json")
    if os.path.isfile(cache_file):
        try:
            mtime = os.path.getmtime(cache_file)
            if time.time() - mtime < 86400 * 7:
                with open(cache_file, "r", encoding="utf-8") as f:
                    _TLDR_INDEX = json.load(f)
                    return _TLDR_INDEX
        except Exception:
            pass

    root = find_tldr_root()
    index = {}
    if not root:
        _TLDR_INDEX = index
        return index

    # Order of priority: linux, common, osx, others
    platforms = ["sunos", "windows", "freebsd", "openbsd", "netbsd", "android", "osx", "common", "linux"]
    for plat in platforms:
        pdir = os.path.join(root, plat)
        if os.path.isdir(pdir):
            try:
                for entry in os.scandir(pdir):
                    if entry.name.endswith(".md"):
                        cmd_name = entry.name[:-3]
                        index[cmd_name] = entry.path
            except Exception:
                pass

    try:
        with open(cache_file, "w", encoding="utf-8") as f:
            json.dump(index, f)
    except Exception:
        pass

    _TLDR_INDEX = index
    return index

def parse_tldr_file(filepath):
    """
    Parses a TLDR markdown file into structured data:
    {
      'name': str,
      'description': str,
      'docs': str,
      'examples': [{'desc': str, 'raw_cmd': str, 'clean_cmd': str}]
    }
    """
    if not os.path.isfile(filepath):
        return None

    try:
        with open(filepath, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except Exception:
        return None

    name = ""
    desc_lines = []
    docs_url = ""
    examples = []
    current_desc = None

    for line in lines:
        s = line.strip()
        if not s:
            continue

        if s.startswith("# "):
            name = s[2:].strip()
        elif s.startswith("> "):
            content = s[2:].strip()
            if "More information:" in content:
                m = re.search(r"<(https?://[^>]+)>|(https?://\S+)", content)
                if m:
                    docs_url = m.group(1) or m.group(2)
            elif "See also:" in content:
                desc_lines.append(content)
            else:
                desc_lines.append(content)
        elif s.startswith("- "):
            current_desc = s[2:].rstrip(":").strip()
        elif s.startswith("`") and s.endswith("`") and len(s) >= 2:
            raw_cmd = s[1:-1].strip()
            clean_cmd = re.sub(r"\{\{([^}]+)\}\}", r"\1", raw_cmd)
            if current_desc:
                examples.append({
                    "desc": current_desc,
                    "raw_cmd": raw_cmd,
                    "clean_cmd": clean_cmd
                })
                current_desc = None

    return {
        "name": name,
        "description": " ".join(desc_lines),
        "docs": docs_url,
        "examples": examples
    }

