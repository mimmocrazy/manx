def run_explain(cmd_string):
    print_head(f"Explaining Command: {cmd_string}")
    output = fetch_mankier_explain(cmd_string)
    if not output:
        print_err("Unable to explain command.")
        return

    # Format Mankier / offline output with Tokyo Night colors
    for line in output.splitlines():
        s = line.strip()
        if s.startswith("-"):
            print(f"  {C_PROMPT}{s}{NC}")
        elif re.match(r"^[a-zA-Z0-9_\-]+\([0-9]\)", s):
            print(f"\n{C_HEAD}:: {C_BOLD}{s}{NC}")
        elif s.startswith("http"):
            print(f"  {C_OPT}{s}{NC}")
        else:
            print(f"  {C_TEXT}{line}{NC}")
    print()

# --- UPDATE CACHE ---
def update_cache():
    print_head("Updating Documentation Caches")
    if shutil.which("tldr"):
        print_action("Running `tldr --update`...")
        subprocess.run(["tldr", "--update"])
        print_succ("TLDR pages cache updated.")
    else:
        print_err("tldr binary not found to update cache.")

    cdir = get_cache_dir()
    for fname in ["man_index.json", "tldr_index.json"]:
        fpath = os.path.join(cdir, fname)
        if os.path.exists(fpath):
            os.remove(fpath)

    for sub in ["man", "options", "cheat", "explain"]:
        sdir = os.path.join(cdir, sub)
        if os.path.isdir(sdir):
            shutil.rmtree(sdir)
            os.makedirs(sdir, exist_ok=True)

    print_succ("Refreshed all local indices and cache files.")

